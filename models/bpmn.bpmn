<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ARviz" targetNamespace="https://mirea.ru/student/arviz">
  <bpmn:process id="Process_ARSession" name="Настройка и проведение сеанса AR-визуализации музыкального трека" isExecutable="false">
    <bpmn:laneSet id="Process_ARSession_lanes">
      <bpmn:lane id="listener" name="Слушатель">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Приложение">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>features</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Слушатель решил включить AR-визуализацию трека">
      <bpmn:outgoing>Process_ARSession_flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="choose" name="Выбрать трек и пресет">
      <bpmn:incoming>Process_ARSession_flow0</bpmn:incoming>
      <bpmn:incoming>Process_ARSession_flow4</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="position" name="Разместить объекты и подтвердить запуск">
      <bpmn:incoming>Process_ARSession_flow6</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Слушатель получил визуальное сопровождение трека, сеанс завершён">
      <bpmn:incoming>Process_ARSession_flow16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="validate" name="Проверить исходные данные">
      <bpmn:incoming>Process_ARSession_flow1</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="valid" name="Данные подходят?">
      <bpmn:incoming>Process_ARSession_flow2</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow3</bpmn:outgoing>
      <bpmn:outgoing>Process_ARSession_flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="error" name="Сообщить об ошибке">
      <bpmn:incoming>Process_ARSession_flow3</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="prepare" name="Подготовить AR-сцену">
      <bpmn:incoming>Process_ARSession_flow5</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="begin" name="Создать анализ и сеанс">
      <bpmn:incoming>Process_ARSession_flow7</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="next" name="Сеанс активен и есть полный кадр?">
      <bpmn:incoming>Process_ARSession_flow8</bpmn:incoming>
      <bpmn:incoming>Process_ARSession_flow15</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow9</bpmn:outgoing>
      <bpmn:outgoing>Process_ARSession_flow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="fft" name="Рассчитать спектр кадра">
      <bpmn:incoming>Process_ARSession_flow9</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="features" name="Извлечь признаки кадра">
      <bpmn:incoming>Process_ARSession_flow11</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="map" name="Сформировать параметры визуализации">
      <bpmn:incoming>Process_ARSession_flow12</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="save" name="Сохранить результат кадра">
      <bpmn:incoming>Process_ARSession_flow13</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="display" name="Обновить объекты AR-сцены">
      <bpmn:incoming>Process_ARSession_flow14</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="close" name="Завершить сеанс">
      <bpmn:incoming>Process_ARSession_flow10</bpmn:incoming>
      <bpmn:outgoing>Process_ARSession_flow16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="track_object"/>
    <bpmn:dataObjectReference id="track" name="Трек (Track)" dataObjectRef="track_object"/>
    <bpmn:dataObject id="preset_object"/>
    <bpmn:dataObjectReference id="preset" name="Пресет (VisualPreset)" dataObjectRef="preset_object"/>
    <bpmn:dataObject id="profile_object"/>
    <bpmn:dataObjectReference id="profile" name="Профиль анализа (AnalysisProfile)" dataObjectRef="profile_object"/>
    <bpmn:dataObject id="run_object"/>
    <bpmn:dataObjectReference id="run" name="Анализ (AnalysisRun)" dataObjectRef="run_object"/>
    <bpmn:dataObject id="session_object"/>
    <bpmn:dataObjectReference id="session" name="Сеанс (VisualizationSession)" dataObjectRef="session_object"/>
    <bpmn:dataObject id="frame_object"/>
    <bpmn:dataObjectReference id="frame" name="Признаки кадра (AnalysisFrame)" dataObjectRef="frame_object"/>
    <bpmn:dataObject id="visual_object"/>
    <bpmn:dataObjectReference id="visual" name="Параметры кадра (VisualFrame)" dataObjectRef="visual_object"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow0" sourceRef="start" targetRef="choose"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow1" sourceRef="choose" targetRef="validate"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow2" sourceRef="validate" targetRef="valid"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow3" sourceRef="valid" targetRef="error" name="Нет"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow4" sourceRef="error" targetRef="choose"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow5" sourceRef="valid" targetRef="prepare" name="Да"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow6" sourceRef="prepare" targetRef="position"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow7" sourceRef="position" targetRef="begin"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow8" sourceRef="begin" targetRef="next"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow9" sourceRef="next" targetRef="fft" name="Да"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow10" sourceRef="next" targetRef="close" name="Нет"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow11" sourceRef="fft" targetRef="features"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow12" sourceRef="features" targetRef="map"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow13" sourceRef="map" targetRef="save"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow14" sourceRef="save" targetRef="display"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow15" sourceRef="display" targetRef="next"/>
    <bpmn:sequenceFlow id="Process_ARSession_flow16" sourceRef="close" targetRef="end"/>
    <bpmn:association id="Process_ARSession_flow17" sourceRef="track" targetRef="choose" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow18" sourceRef="preset" targetRef="choose" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow19" sourceRef="profile" targetRef="validate" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow20" sourceRef="begin" targetRef="run" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow21" sourceRef="begin" targetRef="session" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow22" sourceRef="features" targetRef="frame" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow23" sourceRef="map" targetRef="visual" associationDirection="One"/>
    <bpmn:association id="Process_ARSession_flow24" sourceRef="visual" targetRef="display" associationDirection="One"/>
  </bpmn:process>
  <bpmn:collaboration id="Process_ARSession_collaboration">
    <bpmn:participant id="Process_ARSession_pool" name="Настройка и проведение сеанса AR-визуализации музыкального трека" processRef="Process_ARSession"/>
  </bpmn:collaboration>
